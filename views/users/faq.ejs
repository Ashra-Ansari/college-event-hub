<% layout('/layouts/boilerplate') -%>

<body>
  <div class="container my-5">
    <h2 class="text-center mb-4">Frequently Asked Questions (FAQ)</h2>

    <div class="accordion" id="faqAccordion">
      <!-- Q1 -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button
            class="accordion-button"
            data-bs-toggle="collapse"
            data-bs-target="#q1"
          >
            How can I register for an event?
          </button>
        </h2>
        <div id="q1" class="accordion-collapse collapse">
          <div class="accordion-body">
            You can register by opening the event details page and clicking on
            the register option (if available).
          </div>
        </div>
      </div>

      <!-- Q2 -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button
            class="accordion-button collapsed"
            data-bs-toggle="collapse"
            data-bs-target="#q2"
          >
            Do I need an account to view events?
          </button>
        </h2>
        <div id="q2" class="accordion-collapse collapse">
          <div class="accordion-body">
            Yes, you can't view events without logging in.
          </div>
        </div>
      </div>

      <!-- Q3 -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button
            class="accordion-button collapsed"
            data-bs-toggle="collapse"
            data-bs-target="#q3"
          >
            Who can create or manage events?
          </button>
        </h2>
        <div id="q3" class="accordion-collapse collapse">
          <div class="accordion-body">
            Only authorized users (admins or organizers) can create, update, or
            delete events.
          </div>
        </div>
      </div>

      <!-- Q4 -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button
            class="accordion-button collapsed"
            data-bs-toggle="collapse"
            data-bs-target="#q4"
          >
            How can I leave a review?
          </button>
        </h2>
        <div id="q4" class="accordion-collapse collapse">
          <div class="accordion-body">
            You must be logged in to leave a review. After logging in, go to the
            event page and submit your rating and comment.
          </div>
        </div>
      </div>

      <!-- Q5 -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button
            class="accordion-button collapsed"
            data-bs-toggle="collapse"
            data-bs-target="#q5"
          >
            Can I delete my review?
          </button>
        </h2>
        <div id="q5" class="accordion-collapse collapse">
          <div class="accordion-body">
            Yes, users can delete their own reviews from the event page.
          </div>
        </div>
      </div>

      <!-- Q6 -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button
            class="accordion-button collapsed"
            data-bs-toggle="collapse"
            data-bs-target="#q6"
          >
            What should I do if I find incorrect event information?
          </button>
        </h2>
        <div id="q6" class="accordion-collapse collapse">
          <div class="accordion-body">
            You can contact the event organizer or report the issue through the
            platform.
          </div>
        </div>
      </div>
    </div>

    <div class="text-center mt-4">
      <a href="/events" class="btn btn-dark">Back to Events</a>
    </div>
  </div>

  <!-- <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script> -->
</body>
