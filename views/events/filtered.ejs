<% layout('/layouts/boilerplate') -%>

<h1 class="text-center mt-3"><%= categoryName %></h1>

<div class="container mt-4">
  <div class="events-grid">

    <% if (filteredEvents.length === 0) { %>

      <!-- No Events UI -->
      <div class="no-events">
        <h2>No events found 😕</h2>
        <p>There are no events available in this category right now.</p>
        <a href="/events" class="custom-btn custom-btn-primary">Browse All Events</a>
      </div>

    <% } else { %>

      <% for (let event of filteredEvents) { %>

        <a href="/events/<%= event._id %>" class="event-card">

          <!-- Image -->
          <div class="event-card-img">
            <img src="<%= event.image.url %>" alt="<%= event.title %>" />
          </div>

          <!-- Content -->
          <div class="event-card-body">

            <h3 class="event-title"><%= event.title %></h3>

            <div class="event-meta">

              <!-- Date -->
              <div class="event-meta-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="4" width="18" height="18" rx="2" />
                  <line x1="16" y1="2" x2="16" y2="6" />
                  <line x1="8" y1="2" x2="8" y2="6" />
                  <line x1="3" y1="10" x2="21" y2="10" />
                </svg>
                <%= event.date %>
              </div>

              <!-- Venue -->
              <div class="event-meta-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
                <%= event.venue %>
              </div>

            </div>

            <!-- View Details -->
            <div class="event-view-wrapper">
              <span class="event-view-link">View Details</span>
            </div>

          </div>

        </a>

      <% } %>

    <% } %>

  </div>
</div>