<% layout('/layouts/boilerplate') %>

<div class="show-event my-5">

  <!-- Event Title -->
  <h2 class="text-center mb-4"><%= event.title %></h2>

  <!-- Event Details Card -->
  <div class="event-card mx-auto p-4">

    <ul class="event-details list-unstyled mb-4">
      <i><li><strong>Owner:</strong> <%= event.owner.username %></li></i>
      <li><strong>Description:</strong> <%= event.description %></li>
      <li><strong>Category:</strong> <%= event.category %></li>
      <li><strong>Date:</strong> <%= event.date %></li>
      <li><strong>Time:</strong> <%= event.time %></li>
      <li><strong>Duration:</strong> <%= event.duration %></li>
      <li><strong>Venue:</strong> <%= event.venue %></li>
      <li><strong>Team Size:</strong> <%= event.teamSize %></li>
    </ul>

<% if (event.technologies && event.technologies.length > 0) { %>
  <h4>Technologies Allowed</h4>
  <ul class="list-unstyled mb-3">
    <% event.technologies.forEach(tech => { %>
      <li>• <%= tech %></li>
    <% }) %>
  </ul>
<% } %>
    <h4>Prizes</h4>
    <ul class="list-unstyled mb-3">
      <% event.prizes.forEach(prize => { %>
        <li>• <%= prize %></li>
      <% }) %>
    </ul>

    <h4>Rules</h4>
    <ul class="list-unstyled mb-3">
      <% event.rules.forEach(rule => { %>
        <li>• <%= rule %></li>
      <% }) %>
    </ul>    
 <!-- // REGISTER -->

<% if (currentUser && currentUser.role === "student") { %>
  <div class="text-center my-4">
    <% if (registration) { %>
      <button class="btn btn-secondary" disabled>
        Already Registered
      </button>
    <% } else { %>
      <form action="/events/<%= event._id %>/register" method="GET">
        <button class="btn btn-success">Register</button>
      </form>
    <% } %>
  </div>
<% } %>


<!-- Edit/Delete Buttons -->

    <% if(currentUser && currentUser._id.equals(event.owner._id)) { %>
   
    <div class="d-flex justify-content-center gap-3 my-4">

      <form method="get" action="/events/<%= event._id %>/edit">
        <button class="btn btn-dark">Edit</button>
      </form>

      <form method="post" action="/events/<%= event._id %>?_method=DELETE">
        <button class="btn btn-dark ">Delete</button>
      </form>
    </div>
    <% } %>

    
    <!-- Review Form -->
    <hr>
    <% if(currentUser) { %>
    <h4 class="text-center mb-3">Leave a Review</h4>
    <form action="/events/<%= event._id %>/reviews" method="post" class="needs-validation mx-auto" style="max-width:600px;" novalidate>
      <!-- <div class="mb-3">
        <label for="rating" class="form-label">Rating</label>
        <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
      </div> -->


<div class="mb-3">

  <label for="rating" class="form-label">Rating</label>
      <fieldset class="starability-slot">
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>
</div>
      <div class="mb-3">
        <label for="comment" class="form-label">Comments</label>
        <textarea name="review[comment]" id="comment" rows="4" class="form-control" required></textarea>
        <div class="invalid-feedback">Comments Required*</div>
      </div>
      <div class="text-center">
        <button class="btn btn-outline-dark">Submit</button>
      </div>
    </form>
<% } %>
    <!-- All Reviews -->
   
    <h4 class="text-center mb-3">All Reviews</h4>
    <div class="reviews-list mx-auto" style="max-width:700px;">
      <% for(review of event.reviews) { %>
        <div class="card mb-3 p-3">

          <p class="mb-1"><b>@<%= review.author.username %></b></p>
          <p class="starability-result card-text" data-rating="<%= review.rating %>">
          </p>
          <p class="mb-1"><%= review.comment %></p>
          <form action="/events/<%= event._id %>/reviews/<%= review._id %>?_method=DELETE" method="post" class="text-end mt-2">
            <button class="btn btn-sm btn-dark">Delete</button>
          </form>
        </div>
      <% } %>
    </div>

  </div>
</div>