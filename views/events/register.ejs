<% layout('/layouts/boilerplate') %>

<div class="auth-container">
  <a href="/" class="auth-brand"> College<span>Event</span>Hub </a>

  <div class="auth-card">
    <h1>Event Registration</h1>

    <p class="auth-subtitle">Register for <%= event.title %></p>

    <form action="/events/<%= event._id %>/register" method="POST">
      <div class="auth-field">
        <label for="name">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          placeholder="Enter your name"
          required
        />
      </div>

      <div class="auth-field">
        <label for="email">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="Enter your email"
          required
        />
      </div>

      <div class="auth-field">
        <label for="department">Department</label>
        <input
          type="text"
          id="department"
          name="department"
          placeholder="e.g. Information Technology"
          required
        />
      </div>

      <div class="auth-field">
        <label for="phone">Phone Number</label>
        <input
          type="tel"
          id="phone"
          name="phone"
          placeholder="Enter your phone number"
          required
        />
      </div>

      <button type="submit" class="auth-submit">Submit Registration</button>
    </form>
  </div>
</div>
