
<% layout('/layouts/boilerplate') -%>

    <!-- HERO -->
    <section class="hero">
      <!-- <div class="hero-blob1"></div>
      <div class="hero-blob2"></div> -->
      <div class="hero-content">
        <div class="hero-badge">✨ Your Campus, Your Events</div>
        <h1>
          Discover Amazing <span class="text-gradient">College Events</span>
        </h1>
        <p>
          Connect with your campus community. Find workshops, parties,
          hackathons, and more — all in one place.
        </p>
        <div class="custom-hero-buttons">
         <a href="/events"><button class="custom-btn custom-btn-hero">📅 Explore Events</button></a>
          <a href="/events/new"><button class="custom-btn custom-btn-hero-outline">👥 Host an Event</button></a>
        </div>
        <div class="hero-stats">
          <div>
            <div class="hero-stat-value text-gradient">500+</div>
            <div class="hero-stat-label">Events</div>
          </div>
          <div>
            <div class="hero-stat-value text-gradient">50+</div>
            <div class="hero-stat-label">Colleges</div>
          </div>
          <div>
            <div class="hero-stat-value text-gradient">10K+</div>
            <div class="hero-stat-label">Students</div>
          </div>
        </div>
      </div>
    </section>

    <!-- FEATURED EVENTS -->
    <section class="featured" id="featured-events">
      <div class="container">
        <div class="section-header">
          <h2>Featured <span class="text-gradient">Events</span></h2>
          <p>
            Don't miss out on the most exciting events happening across campuses
          </p>
        </div>
      
        <div class="events-grid">
          <!-- Card 1 -->
          <a href="/events/69ff2fe31c2fb6272ed2c678" class="event-card">
            <div class="event-card-img">
              <img
                src="https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=400&h=250&fit=crop"
                alt="TechFest Hackathon"
              />
              <!-- <span class="event-card-badge">Tech</span> -->
            </div>
            <div class="event-card-body">
              <h3>AI Innovation Hackathon
</h3>
              <div class="event-meta">
                <div class="event-meta-item">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                  </svg>
                  Mar 1, 2025
                </div>
                <div class="event-meta-item">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                    <circle cx="12" cy="10" r="3" />
                  </svg>
                  Main Auditorium
                </div>
              </div>
              <button class="btn btn-outline" style="width: 100%">
                View Details
              </button>
            </div>
          </a>
          <!-- Card 2 -->
          <a href="/events/69ff2fe31c2fb6272ed2c680" class="event-card">
            <div class="event-card-img">
              <img
                src="https://images.unsplash.com/photo-1492684223066-81342ee5ff30?w=400&h=250&fit=crop"
                alt="Cloud Computing Workshop"
              />
              <!-- <span class="event-card-badge">Cultural</span> -->
            </div>
            <div class="event-card-body">
              <h3>Cloud Computing Workshop
</h3>
              <div class="event-meta">
                <div class="event-meta-item">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                  </svg>
                  Mar 15, 2025
                </div>
                <div class="event-meta-item">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                    <circle cx="12" cy="10" r="3" />
                  </svg>
                  Open Air Theatre
                </div>
              </div>
              <button class="btn btn-outline" style="width: 100%">
                View Details
              </button>
            </div>
          </a>
          <!-- Card 3 -->
          <a href="/events/69ff2fe31c2fb6272ed2c67a" class="event-card">
            <div class="event-card-img">
              <img
                src="https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=400&h=250&fit=crop"
                alt="Career Fair"
              />
              <!-- <span class="event-card-badge">Career</span> -->
            </div>
            <div class="event-card-body">
              <h3>Bug Hunt Challenge
</h3>
              <div class="event-meta">
                <div class="event-meta-item">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                  </svg>
                  Mar 22, 2025
                </div>
                <div class="event-meta-item">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                    <circle cx="12" cy="10" r="3" />
                  </svg>
                  Convention Center
                </div>
              </div>
              <button class="btn btn-outline" style="width: 100%">
                View Details
              </button>
            </div>
          </a>
        </div>
        <div class="view-all-btn">
          <a href="/events"><button class="btn btn-hero">View All Events</button></a>
        </div>
      </div>
    </section>

    <!-- CATEGORIES -->
    <section class="categories" id="featured-categories">
      <div class="container">
        <div class="section-header">
          <h2>Browse by <span class="text-gradient">Category</span></h2>
          <p>Find events that match your interests</p>
        </div>
        <div class="categories-grid">
          <a href="/events/category/tech-hackathons" class="category-card">
            <div class="category-icon cat-primary">💻</div>
            <h3>Tech & Hackathons</h3>
          </a>
          <a href="/events/category/music-concerts" class="category-card">
            <div class="category-icon cat-accent">🎵</div>
            <h3>Music & Concerts</h3>
          </a>
          <a href="/events/category/career-jobs" class="category-card">
            <div class="category-icon cat-primary">💼</div>
            <h3>Career & Jobs</h3>
          </a>
          <a href="/events/category/sports-games" class="category-card">
            <div class="category-icon cat-accent">🏆</div>
            <h3>Sports & Games</h3>
          </a>
          <a href="/events/category/workshops" class="category-card">
            <div class="category-icon cat-primary">🎓</div>
            <h3>Workshops</h3>
          </a>
          <a href="/events/category/art-culture" class="category-card">
            <div class="category-icon cat-accent">🎨</div>
            <h3>Art & Culture</h3>
          </a>
          <a href="/events/category/social-clubs" class="category-card">
            <div class="category-icon cat-accent">❤️</div>
            <h3>Social & Clubs</h3>
          </a>
          <a href="/events/category/talks-seminars" class="category-card">
            <div class="category-icon cat-primary">🎤</div>
            <h3>Talks & Seminars</h3>
          </a>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="how-it-works" id="featured-how-it-works">
      <div class="container">
        <div class="section-header">
          <h2>How It <span class="text-gradient">Works</span></h2>
          <p>
            Getting started is easy — three simple steps to your next adventure
          </p>
        </div>
        <div class="steps-grid">
          <div class="step">
            <span class="step-number">01</span>
            <div class="step-icon">🔍</div>
            <h3>Discover Events</h3>
            <p>
              Browse through hundreds of events happening at colleges near you
            </p>
            <span class="step-connector"></span>
          </div>
          <div class="step">
            <span class="step-number">02</span>
            <div class="step-icon">📋</div>
            <h3>Register</h3>
            <p>Sign up instantly with your college email and save your spot</p>
            <span class="step-connector"></span>
          </div>
          <div class="step">
            <span class="step-number">03</span>
            <div class="step-icon">🎉</div>
            <h3>Attend & Connect</h3>
            <p>Show up, have fun, and make memories with fellow students</p>
          </div>
        </div>
      </div>
    </section>

</html>
